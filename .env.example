# Copy this file to `.env` and fill in real values.
#
# WINDOWS WARNING: Explorer hides known file extensions, so "New > Text
# Document" renamed to ".env" silently becomes ".env.txt", which the code will
# not read. Create it one of these ways instead:
#   - VS Code: File > New File, save as `.env` (VS Code does not append .txt)
#   - Notepad: File > Save As, set "Save as type" to "All Files (*.*)"
#   - PowerShell: New-Item .env -ItemType File    (then edit it in an editor)
# `python scripts/check_setup.py` will tell you if you hit this.
#
# `.env` is gitignored. NEVER put a real key in this example file, and never
# type a key into a terminal -- shell history keeps it in plaintext.

# Required. Your API key.
OPENAI_API_KEY=

# Optional. Model tiers -- see docs/progress.md for the choice still to confirm.
PLATO_MODEL_CHEAP=gpt-4.1-mini
PLATO_MODEL_STRONG=gpt-4.1

# Optional. Any OpenAI-compatible endpoint (Azure, vLLM, a proxy).
# PLATO_LLM_BASE_URL=

# Optional. `mock` (default, no robot needed) or `real`.
PLATO_HARDWARE=mock

# Optional. Stubbed skill success probability. See skills/executor.py.
PLATO_FAKE_SUCCESS_RATE=1.0
