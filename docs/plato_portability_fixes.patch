From f7918d36a5c3da2783f62c68a4ad55e2de91b68d Mon Sep 17 00:00:00 2001
From: Aliyah <aredding@andrew.cmu.edu>
Date: Fri, 4 Sep 2026 17:51:34 -0400
Subject: [PATCH] Make requirements.txt pip-parseable and drop author-absolute
 paths

- requirements.txt: fix three single-'=' pins to '==' (scikit-image,
  faiss, pydensecrf) and remove the duplicate conflicting Pillow pin.
  The file previously did not parse at all.
- exec_script.py: replace hardcoded /home/arvind/LLM_Tool/... sys.path
  and save-dir entries with paths resolved relative to this checkout,
  overridable via PLATO_SAVE_DIR. TerminationCheck/get_centroid/do_grasp
  imports guarded rather than deleted, since the originals do not exist
  in a fresh clone (step_termination.py) or need submodules initialised.

Local branch only -- not pushed anywhere. Rebase onto a fork once one
exists; see docs/plato_portability_fixes.patch for the same diff as a
plain file, independent of this branch.
---
 .gitignore             |  3 +++
 PLATO/exec_script.py   | 44 ++++++++++++++++++++++++++++++++++--------
 PLATO/requirements.txt | 16 ++++++++++-----
 3 files changed, 50 insertions(+), 13 deletions(-)

diff --git a/.gitignore b/.gitignore
index e84eb37..e5c896d 100644
--- a/.gitignore
+++ b/.gitignore
@@ -17,3 +17,6 @@ verts.csv
 **/__pycache__/
 *.vscode/
 **/Trials/
+
+# Local safety net -- not committed to upstream ArvindCar/PLATO
+*.orig
diff --git a/PLATO/exec_script.py b/PLATO/exec_script.py
index ff2c9f0..2d9c1df 100644
--- a/PLATO/exec_script.py
+++ b/PLATO/exec_script.py
@@ -12,17 +12,43 @@ import threading
 import cv2
 import re
 
-sys.path.append('/home/arvind/LLM_Tool/LLM-Tool')
+# Absolute sys.path hacks pointing at the original author's machine
+# ('/home/arvind/LLM_Tool/...') replaced with package-relative resolution, so a
+# fresh clone works from any checkout location.
+_PLATO_PKG = os.path.dirname(os.path.abspath(__file__))   # .../PLATO/PLATO
+_PLATO_ROOT = os.path.dirname(_PLATO_PKG)                 # .../PLATO
+for _extra in (
+    _PLATO_PKG,
+    os.path.join(_PLATO_ROOT, "SAM"),
+    os.path.join(_PLATO_ROOT, "grasping", "grasping", "os_tog", "notebooks"),
+):
+    if _extra not in sys.path:
+        sys.path.append(_extra)
+
 from overall_planner import OverallPlanner
 from scene_comprehension import SceneComprehension
-from step_termination import TerminationCheck
 from step_planner import Plan2Action
 
-sys.path.append('/home/arvind/LLM_Tool/SAM')
-from object_segmentation import get_centroid
+# NOTE: upstream imports `TerminationCheck` from a `step_termination` module that
+# is not present in this repository, so the original import raised ImportError on
+# a fresh clone. Guarded here rather than deleted, so the intent stays visible.
+try:
+    from step_termination import TerminationCheck
+except ImportError:  # pragma: no cover - module absent upstream
+    TerminationCheck = None
+
+# `object_segmentation` and `grasping` live in git submodules (SAM/GroundingDINO
+# and grasping/os_tog). They are empty until `git submodule update --init
+# --recursive` has been run, and they need the real camera and model weights.
+try:
+    from object_segmentation import get_centroid
+except ImportError:  # pragma: no cover - submodule not initialised
+    get_centroid = None
 
-sys.path.append('/home/arvind/LLM_Tool/grasping/grasping/os_tog/notebooks')
-from grasping import do_grasp
+try:
+    from grasping import do_grasp
+except ImportError:  # pragma: no cover - submodule not initialised
+    do_grasp = None
 
 
 def rotate_x(matrix, angle):
@@ -351,8 +377,10 @@ if __name__ == "__main__":
     #TODO: Change this to be generated by an LLM
     ActionList = ["Pick-up", "Push-down", "Move-to", "Release", "Roll", "Scoop", "Pour"]
 
-    #TODO:
-    base_dir = "/home/arvind/LLM_Tool/Save_dir/"
+    # Was hardcoded to the original author's machine
+    # ("/home/arvind/LLM_Tool/Save_dir/"). Now relative to this checkout, and
+    # overridable with PLATO_SAVE_DIR.
+    base_dir = os.environ.get("PLATO_SAVE_DIR", os.path.join(_PLATO_ROOT, "Save_dir"))
     timestamp = datetime.now().strftime("%m%d_%H%M%S")
 
     new_dir_name = f"{Task}_{timestamp}"
diff --git a/PLATO/requirements.txt b/PLATO/requirements.txt
index b2c9be3..9f2f471 100644
--- a/PLATO/requirements.txt
+++ b/PLATO/requirements.txt
@@ -19,13 +19,13 @@ fast_pytorch_kmeans==0.2.0.1
 matplotlib
 numpy==1.23.0
 opencv_python
-Pillow==9.5.0
+# removed duplicate conflicting pin 'Pillow==9.5.0' (pillow==10.3.0 above wins)
 pytorch_metric_learning==2.5.0
 PyYAML==6.0.1
 scikit_learn==1.3.0
 scipy==1.13.0
 Shapely==2.0.4
-scikit-image=0.17.2
+scikit-image==0.17.2
 timm
 torch==2.0.1
 torchvision==0.15.2
@@ -34,8 +34,14 @@ addict
 yapf
 supervision>=0.22.0
 git+https://github.com/facebookresearch/segment-anything.git
-onnxruntime 
+onnxruntime
 onnx
-faiss=1.5
-pydensecrf=1.0
+faiss==1.5
+pydensecrf==1.0
 
+
+# NOTE: 'faiss' and 'pydensecrf' are not installable from PyPI under these names/
+# versions (faiss ships as faiss-cpu / faiss-gpu; pydensecrf needs a source build).
+# The '==' fixes above make the file *parseable* by pip, which is what was blocking
+# everything. Resolving those two to installable distributions is tracked in
+# docs/progress.md. The chemistry pipeline in this repo does not import either one.
-- 
